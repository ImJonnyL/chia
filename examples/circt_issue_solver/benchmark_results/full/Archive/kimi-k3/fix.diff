diff --git a/test/Conversion/FIRRTLToHW/lower-to-hw-errors.mlir b/test/Conversion/FIRRTLToHW/lower-to-hw-errors.mlir
index 106dd5c..3d5960f 100644
--- a/test/Conversion/FIRRTLToHW/lower-to-hw-errors.mlir
+++ b/test/Conversion/FIRRTLToHW/lower-to-hw-errors.mlir
@@ -278,3 +278,25 @@ firrtl.circuit "InstanceChoiceWithoutInstanceMacro" {
     firrtl.instance_choice inst @Foo alternatives @Opt { @FPGA -> @Foo } ()
   }
 }
+
+// -----
+
+// Two ForceNameAnnotations force two different instances in the same module
+// to the same Verilog name.  This must be an error rather than silently
+// producing instances whose forced names will lose to later name uniquing.
+firrtl.circuit "ForceNameNotUnique" {
+  hw.hierpath private @nla_1 [@ForceNameNotUnique::@sym_foo, @ForceNameSubmodule]
+  hw.hierpath private @nla_2 [@ForceNameNotUnique::@sym_bar, @ForceNameSubmodule]
+  firrtl.module private @ForceNameSubmodule() attributes {annotations = [
+    {circt.nonlocal = @nla_1,
+     class = "chisel3.util.experimental.ForceNameAnnotation", name = "Foo"},
+    {circt.nonlocal = @nla_2,
+     class = "chisel3.util.experimental.ForceNameAnnotation", name = "Foo"}
+  ]} {}
+  firrtl.module @ForceNameNotUnique() {
+    // expected-error @below {{'hw.instance' op has a 'chisel3.util.experimental.ForceNameAnnotation' which would not have a unique Verilog name in module 'ForceNameNotUnique'; instance 'sym_bar' is forced to the same name 'Foo'}}
+    // expected-error @below {{'firrtl.instance' op LowerToHW couldn't handle this operation}}
+    firrtl.instance foo sym @sym_foo @ForceNameSubmodule()
+    firrtl.instance bar sym @sym_bar @ForceNameSubmodule()
+  }
+}
