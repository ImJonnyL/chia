+        if (otherName == forceName &&
+            otherSym != newInstance.getInnerNameAttr())
+          return newInstance.emitOpError()
+                 << "has a '" << forceNameAnnoClass
+                 << "' which would not have a unique Verilog name in module '"
+                 << parentModule.getName() << "'; instance '"
+                 << cast<StringAttr>(otherSym).getValue()
