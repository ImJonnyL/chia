+// The cached `ltl.and`, `ltl.implication`, and `ltl.clock` operations created
+// for simulation constructs inside a layer block must be placed outside of
+// the layer block, since they may be shared with simulation constructs in
+// sibling layer blocks. See https://github.com/llvm/circt/issues/10104.
+firrtl.layer @LayerWithVerifOps bind {}
+// CHECK-LABEL: firrtl.module @LayerBlocksWithSharedImplications
+firrtl.module @LayerBlocksWithSharedImplications(in %cond : !firrtl.uint<1>) {
+  // CHECK: [[AND:%.+]] = firrtl.int.ltl.and %cond, %cond :
+  // CHECK-NEXT: [[IMPL:%.+]] = firrtl.int.ltl.implication [[AND]], %cond :
+  // CHECK-NEXT: firrtl.layerblock @LayerWithVerifOps {
+  // CHECK-NEXT:   [[IMPL0:%.+]] = firrtl.int.ltl.implication %cond, %cond :
+  // CHECK-NEXT:   firrtl.int.verif.assert [[IMPL]], %cond :
+  // CHECK-NEXT: }
+  // CHECK-NEXT: firrtl.layerblock @LayerWithVerifOps {
+  // CHECK-NEXT:   [[IMPL1:%.+]] = firrtl.int.ltl.implication %cond, %cond :
+  // CHECK-NEXT:   firrtl.int.verif.assert [[IMPL]], %cond :
+  // CHECK-NEXT: }
+  firrtl.when %cond : !firrtl.uint<1> {
+    firrtl.layerblock @LayerWithVerifOps {
+      %0 = firrtl.int.ltl.implication %cond, %cond : (!firrtl.uint<1>, !firrtl.uint<1>) -> !firrtl.uint<1>
+      firrtl.int.verif.assert %0, %cond : !firrtl.uint<1>, !firrtl.uint<1>
+    }
+    firrtl.layerblock @LayerWithVerifOps {
+      %1 = firrtl.int.ltl.implication %cond, %cond : (!firrtl.uint<1>, !firrtl.uint<1>) -> !firrtl.uint<1>
+      firrtl.int.verif.assert %1, %cond : !firrtl.uint<1>, !firrtl.uint<1>
+    }
+  }
+}
