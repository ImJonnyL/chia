--- a/include/circt/Support/Namespace.h
+++ b/include/circt/Support/Namespace.h
@@ -63,6 +63,18 @@ public:
 
   void add(StringRef name) { nextIndex.insert({name, 0}); }
 
+  /// Return true if the specified name is already present in the namespace.
+  bool isNameTaken(StringRef name) const {
+    bool r = nextIndex.contains(name);
+    if (r) {
+      llvm::errs() << "DEBUG isNameTaken(" << name << ") = true; contents:";
+      for (auto &e : nextIndex)
+        llvm::errs() << " [" << e.getKey() << "]";
+      llvm::errs() << "\n";
+    }
+    return r;
+  }
