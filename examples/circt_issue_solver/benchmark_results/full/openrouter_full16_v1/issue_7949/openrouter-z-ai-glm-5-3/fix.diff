diff --git a/test/Conversion/DCToHW/basic.mlir b/test/Conversion/DCToHW/basic.mlir
index 1816276..fc74095 100644
--- a/test/Conversion/DCToHW/basic.mlir
+++ b/test/Conversion/DCToHW/basic.mlir
@@ -202,3 +202,25 @@ hw.module.extern @ext(in %a : i32, out b : i32)
 
 // CHECK:  hw.module.extern @extDC(in %a : !esi.channel<i32>, out b : i32)
 hw.module.extern @extDC(in %a : !dc.value<i32>, out b : i32)
+
+// An unpack of a pack, the token of which is forked, must lower without
+// creating multiple consumers of a single ESI channel. The `dc.unpack` /
+// `dc.pack` pair must not be folded away during the conversion, since the
+// lowering requires every DC value to be used exactly once.
+// CHECK-LABEL: hw.module @unpackOfPackFork(
+// CHECK:           %[[TOKEN:.*]], %{{.*}} = esi.wrap.vr %{{.*}} : i0
+// CHECK:           %{{.*}}, %{{.*}} = esi.unwrap.vr %[[TOKEN]], %{{.*}} : i0
+// CHECK:           %[[PACKED:.*]], %{{.*}} = esi.wrap.vr %{{.*}} : i32
+// CHECK:           %{{.*}}, %{{.*}} = esi.unwrap.vr %[[PACKED]], %{{.*}} : i32
+// CHECK:           hw.output %{{.*}} : !esi.channel<i32>
+// CHECK:         }
+hw.module @unpackOfPackFork(in %arg0 : !dc.value<i32>, in %clk : !seq.clock {dc.clock}, in %rst : i1 {dc.reset}, out out0 : !dc.value<i32>) {
+    %t, %v = dc.unpack %arg0 : !dc.value<i32>
+    %c = hw.constant 0 : i32
+    %p = dc.pack %t, %c : i32
+    %t2, %v2 = dc.unpack %p : !dc.value<i32>
+    %f:2 = dc.fork [2] %t2
+    %a = dc.pack %f#0, %v2 : i32
+    dc.sink %f#1
+    hw.output %a : !dc.value<i32>
+}
diff --git a/test/Dialect/DC/canonicalization.mlir b/test/Dialect/DC/canonicalization.mlir
index baf316e..57dc811 100644
--- a/test/Dialect/DC/canonicalization.mlir
+++ b/test/Dialect/DC/canonicalization.mlir
@@ -166,3 +166,28 @@ hw.module @TestForkCanonicalization(in %arg0: !dc.token, out out0: !dc.token, ou
   dc.sink %0#2
   hw.output %1, %2 : !dc.token, !dc.token
 }
+
+// Unpack of a pack is a no-op. The pack is only eliminated when its result
+// has no other uses.
+// CHECK-LABEL:   func.func @unpackOfPackMultiUse(
+// CHECK-SAME:                          %[[VAL_0:.*]]: !dc.token,
+// CHECK-SAME:                          %[[VAL_1:.*]]: i32) -> (!dc.token, i32, !dc.value<i32>) {
+// CHECK:           %[[VAL_2:.*]] = dc.pack %[[VAL_0]], %[[VAL_1]] : i32
+// CHECK:           return %[[VAL_0]], %[[VAL_1]], %[[VAL_2]] : !dc.token, i32, !dc.value<i32>
+// CHECK:         }
+func.func @unpackOfPackMultiUse(%a: !dc.token, %b : i32) -> (!dc.token, i32, !dc.value<i32>) {
+    %0 = dc.pack %a, %b : i32
+    %1:2 = dc.unpack %0 : !dc.value<i32>
+    return %1#0, %1#1, %0 : !dc.token, i32, !dc.value<i32>
+}
+
+// Pack of an unpack is a no-op. Both operations are eliminated.
+// CHECK-LABEL:   func.func @packOfUnpack(
+// CHECK-SAME:                          %[[VAL_0:.*]]: !dc.value<i32>) -> !dc.value<i32> {
+// CHECK:           return %[[VAL_0]] : !dc.value<i32>
+// CHECK:         }
+func.func @packOfUnpack(%a : !dc.value<i32>) -> (!dc.value<i32>) {
+    %0:2 = dc.unpack %a : !dc.value<i32>
+    %1 = dc.pack %0#0, %0#1 : i32
+    return %1 : !dc.value<i32>
+}
